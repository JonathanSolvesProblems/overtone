# Copy to .env and fill in. .env is gitignored.

# --- Backblaze B2 (required) -------------------------------------------------
# Application key with read+write on the bucket below.
# Create at: https://secure.backblaze.com/app_keys
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=overtone-archive
# Shown on the bucket list, e.g. s3.us-west-004.backblazeb2.com
B2_ENDPOINT=
B2_REGION=us-west-004

# --- Speech to text (required) -----------------------------------------------
# Word-level timings drive the whole gap map.
# https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# --- Vision description (at least one required) ------------------------------
# Gemini reads keyframes and writes the description text.
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Fallback leg of the chain.
OPENAI_API_KEY=

# --- Text to speech (at least one required) ----------------------------------
# Hume Octave is the primary voice; ElevenLabs is the fallback.
# https://platform.hume.ai/  |  https://elevenlabs.io/
HUME_API_KEY=
ELEVENLABS_API_KEY=

# --- GMI Cloud (optional) ----------------------------------------------------
# Hackathon credits, first 270 participants. Used as an additional
# description-model provider to exercise cross-provider failover.
GMI_CLOUD_API_KEY=
